# ================================================================
# Little Learners - Environment Configuration Example
# ================================================================
# Copy this file to .env for local development, or configure these
# variables in your Render Web Service Dashboard for production.

# Database Configuration (MySQL)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=little_learners

# Optional SSL Settings for Cloud MySQL (e.g. TiDB Serverless, Aiven)
# DB_SSL_DISABLED=false
# DB_SSL_VERIFY_CERT=false
# DB_SSL_CA=

# Flask Server Configuration
FLASK_PORT=5000
FLASK_ENV=development
SECRET_KEY=your_secret_key_here
CORS_ORIGIN=http://localhost:5173
